{
  "manifest_version": 2,
  "name": "Skip Link",
  "version": "1.0.0",
  "description": "Lewati halaman shortlink/safelink sampai link download: halaman dikosongkan (iklan & popup hilang), langkah verify/next/get link dijalankan di latar belakang.",
  "browser_specific_settings": {
    "gecko": {
      "id": "skip-link@zidanebayu21.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "120.0" }
  },
  "permissions": ["activeTab", "storage"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Skip Link", "default_icon": "icon.svg" },
  "options_ui": { "page": "options.html" },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "content_scripts": [
    {
      "matches": ["*://sfe.ad/*", "*://*.sfe.ad/*", "*://safelinkearn.com/*", "*://*.safelinkearn.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
